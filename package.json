{
  "name": "vite-plugin-react-router-routecraft",
  "version": "0.1.2",
  "description": "面向 React Router Data Mode 的 Vite 文件路由插件",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alon-wu/vite-plugin-react-router-routecraft.git"
  },
  "homepage": "https://alon-wu.github.io/vite-plugin-react-router-routecraft/",
  "bugs": {
    "url": "https://github.com/alon-wu/vite-plugin-react-router-routecraft/issues"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "Routecraft contributors",
  "keywords": [
    "vite",
    "vite-plugin",
    "react-router",
    "file-routing",
    "typescript"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:pack": "node scripts/package-smoke.mjs",
    "test:pack:min": "node scripts/package-smoke.mjs --minimum-peers",
    "verify": "npm run typecheck && npm run test:coverage && npm run build && npm run example:build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "pack:check": "npm pack --dry-run",
    "example:typecheck": "npm --prefix examples/basic run typecheck",
    "example:build": "npm --prefix examples/basic run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify && npm run test:pack && npm run test:pack:min"
  },
  "peerDependencies": {
    "vite": "^7.0.0",
    "react-router": "^8.5.1"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "vite": "^7.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.4"
    }
  }
}
